#!/usr/bin/env php
<?php
declare(strict_types=1);

/**
 * Script to test hash function consistency across crypto implementations
 * in the 2xx files of the object-oriented library.
 * 
 * This script verifies that all crypto implementations (OpenSSL, Software, Sodium)
 * produce identical hash results for the same input and algorithm.
 */

// ============================================================================
// Configuration
// ============================================================================

$LIB_NEBULE_DIR = __DIR__ . '/lib_nebule';
$TEST_DATA = 'Bienvenue dans le projet nebule.';

// Expected hash values for verification
$EXPECTED_HASHES = [
    'sha1.128' => 'd689bc73bbf35e6547e6de4b0ea79a5fd3b83ffa',
    'sha2.224' => '8ee809ef3ec56e4e31273e2ee232697683d260db72d543ce6db4ab64',
    'sha2.256' => '0b8dc4408e7ab1c81716ae978abe1f75d4bd3ea9a7b882b8da6afacdafc0e32b',
    'sha2.384' => 'fef7e57afdbf243a756eae37fa7c556bc71050f555209d78b29d2e8feef56e62ed92da5e291669b6262170cd4f0dd0ba',
    'sha2.512' => 'b9d7b17462c0e2657171975ee0bd37e8dc0cab5d6ebc6496864af2e261f16d35c16642898ba0af5174ad80bada202032c641595be0fc56e4d35599add72f8079',
];

// RSA test configuration
$RSA_TEST_KEY_SIZES = ['rsa.128', 'rsa.256', 'rsa.1024', 'rsa.2048'];
$RSA_TEST_DATA = 'Test data for RSA encryption and signing';
$RSA_TEST_SMALL_DATA = 'Hello RSA!';

// Test messages for RSA (small messages for faster testing)
$RSA_ENCRYPTION_TESTS = [
    'small_message' => 'Hello!',
    'medium_message' => 'Test RSA',
];

$RSA_SIGNING_TESTS = [
    'short_message' => 'Sign',
    'standard_message' => 'Test sign',
];

// ED25519 test configuration
// Using pre-generated keys to avoid expensive key generation
$ED25519_TESTSeed = 'ad258128049c8c2d00f0e76778c396cb3112f6d49c18d3b17c2250e650f5d59f';

// ED25519 Test messages for signing (small messages for faster testing)
$ED25519_SIGNING_TESTS = [
    'short_message' => 'Test ED25519',
    'standard_message' => 'Test ED25519 signature',
];

// ============================================================================
// Load required library files
// ============================================================================

// Load all necessary files for the crypto classes
$requiredFiles = [
    '000_init.php',
    '001_nebule.php',
    '002_references.php', 
    '003_functions.php',
    '004_metrology.php',
    '005_configuration.php',
    '200_crypto_interface.php',
    '201_crypto.php',
    '202_crypto_openssl.php',
    '203_crypto_software.php',
    '204_crypto_sodium.php',
];

foreach ($requiredFiles as $file) {
    $filePath = $LIB_NEBULE_DIR . '/' . $file;
    if (file_exists($filePath)) {
        require_once $filePath;
    } else {
        printError("Required file not found: $file");
    }
}

// ============================================================================
// Helper functions
// ============================================================================

function printHeader(string $message): void {
    echo "\n" . str_repeat('=', 80) . "\n";
    echo "  " . $message . "\n";
    echo str_repeat('=', 80) . "\n\n";
}

function printSection(string $message): void {
    echo str_repeat('-', 60) . "\n";
    echo "  " . $message . "\n";
    echo str_repeat('-', 60) . "\n";
}

function printResult(string $label, string $value, bool $success = true): void {
    $prefix = $success ? '[OK]' : '[FAIL]';
    echo sprintf("    %-40s %s %s\n", $label . ':', $prefix, $value);
}

function printError(string $message): void {
    echo "    [ERROR] " . $message . "\n";
}

function printWarning(string $message): void {
    echo "    [WARN] " . $message . "\n";
}

// ============================================================================
// Crypto Implementation Classes
// ============================================================================

$CRYPTO_CLASSES = [
    'openssl' => 'Nebule\\Library\\CryptoOpenssl',
    'software' => 'Nebule\\Library\\CryptoSoftware',
    'sodium' => 'Nebule\\Library\\CryptoSodium',
];

// Install error handler to suppress metrology-related warnings/errors in tests
set_error_handler(function($errno, $errstr, $errfile, $errline) {
    // Suppress errors related to addLog calls on null
    if (strpos($errstr, 'addLog') !== false || strpos($errstr, 'metrology') !== false) {
        return true; // Suppress this error
    }
    return false; // Use default error handler for other errors
});

// Install exception handler to suppress metrology-related exceptions
set_exception_handler(function($exception) {
    // Check if this is a metrology-related exception
    if (strpos($exception->getMessage(), 'addLog') !== false || 
        strpos($exception->getMessage(), 'metrology') !== false ||
        strpos(get_class($exception), 'Error') !== false) {
        // Suppress this exception for test purposes
        return;
    }
    // Re-throw other exceptions
    throw $exception;
});

// Install error handler to suppress metrology-related errors
set_error_handler(function($errno, $errstr, $errfile, $errline) {
    if (strpos($errstr, 'addLog') !== false || 
        strpos($errstr, 'metrology') !== false) {
        // Suppress this error for test purposes
        return true;
    }
    // Use default error handler for other errors
    return false;
});

// ============================================================================
// Main execution
// ============================================================================

// Set reasonable timeout for tests
//set_time_limit(300); // 5 minutes max for RSA key generation
set_time_limit(900);

printHeader('CRYPTO HASH CONSISTENCY TEST');

echo "Test data: '" . $TEST_DATA . "'\n\n";

// ============================================================================
// Step 1: Check which implementations are available
// ============================================================================

printSection('Step 1: Checking available implementations');

$availableImplementations = [];
$unavailableImplementations = [];

foreach ($CRYPTO_CLASSES as $name => $className) {
    try {
        if (class_exists($className)) {
            $availableImplementations[$name] = $className;
            printResult($name, 'Available');
        } else {
            $unavailableImplementations[$name] = $className;
            printError("$name class not found");
        }
    } catch (Throwable $e) {
        $unavailableImplementations[$name] = $className;
        printError("$name: " . $e->getMessage());
    }
}

if (empty($availableImplementations)) {
    echo "\nNo crypto implementations available. Exiting.\n";
    exit(1);
}

// ============================================================================
// Step 2: Instantiate available implementations
// ============================================================================

printSection('Step 2: Instantiating implementations');

$instances = [];
foreach ($availableImplementations as $name => $className) {
    try {
        // Crypto classes need a Nebule instance for metrology
        // We'll create a minimal mock if needed
        $reflection = new ReflectionClass($className);
        
        // Check if constructor requires parameters
        $constructor = $reflection->getConstructor();
        if ($constructor === null || $constructor->getNumberOfParameters() === 0) {
            $instances[$name] = new $className();
            printResult($name, 'Instantiated');
        } else {
            // Try to create with null for required Nebule instance
            // This might fail, but we'll try
            try {
                $instances[$name] = $reflection->newInstanceWithoutConstructor();
                // Manually call initialization if needed
                if (method_exists($instances[$name], '_initialisation')) {
                    @$instances[$name]->initialisation();
                }
                printResult($name, 'Instantiated (without constructor)');
            } catch (Throwable $e) {
                printWarning("$name: Could not instantiate - " . $e->getMessage());
                unset($availableImplementations[$name]);
            }
        }
    } catch (Throwable $e) {
        printError("$name: " . $e->getMessage());
        unset($availableImplementations[$name]);
    }
}

if (empty($instances)) {
    echo "\nNo crypto instances could be created. Exiting.\n";
    exit(1);
}

// ============================================================================
// Step 3: Get supported hash algorithms for each implementation
// ============================================================================

printSection('Step 3: Gathering supported hash algorithms');

$supportedAlgorithms = [];
foreach ($instances as $name => $instance) {
    try {
        $algorithms = $instance->getAlgorithmList(\Nebule\Library\Crypto::TYPE_HASH);
        $supportedAlgorithms[$name] = $algorithms;
        printResult($name, implode(', ', $algorithms));
    } catch (Throwable $e) {
        printError("$name: Could not get algorithm list - " . $e->getMessage());
        $supportedAlgorithms[$name] = [];
    }
}

// ============================================================================
// Step 4: Find common algorithms across implementations
// ============================================================================

printSection('Step 4: Finding common hash algorithms');

$commonAlgorithms = [];
if (!empty($supportedAlgorithms)) {
    $firstImpl = array_key_first($supportedAlgorithms);
    $firstAlgos = $supportedAlgorithms[$firstImpl];
    
    foreach ($firstAlgos as $algo) {
        $isCommon = true;
        foreach ($supportedAlgorithms as $implName => $algos) {
            if (!in_array($algo, $algos)) {
                $isCommon = false;
                break;
            }
        }
        if ($isCommon) {
            $commonAlgorithms[] = $algo;
        }
    }
    
    if (!empty($commonAlgorithms)) {
        printResult('Common algorithms', implode(', ', $commonAlgorithms));
    } else {
        printWarning('No common algorithms found across all implementations');
    }
}

// Also test algorithms that are in at least 2 implementations
$multiImplAlgorithms = [];
foreach ($supportedAlgorithms as $implName => $algos) {
    foreach ($algos as $algo) {
        if (!isset($multiImplAlgorithms[$algo])) {
            $multiImplAlgorithms[$algo] = [];
        }
        $multiImplAlgorithms[$algo][] = $implName;
    }
}

$algorithmsToTest = [];
foreach ($multiImplAlgorithms as $algo => $impls) {
    if (count($impls) >= 2) {
        $algorithmsToTest[$algo] = $impls;
    }
}

printResult('Algorithms available in >=2 implementations', implode(', ', array_keys($algorithmsToTest)));

// ============================================================================
// Step 5: Test hash consistency
// ============================================================================

printSection('Step 5: Testing hash consistency');

$allPassed = true;
$inconsistencies = [];
$verificationFailures = [];

foreach ($algorithmsToTest as $algo => $implementations) {
    printResult("Algorithm", $algo);
    
    $hashResults = [];
    $successCount = 0;
    
    foreach ($implementations as $implName) {
        if (!isset($instances[$implName])) {
            continue;
        }
        
        $instance = $instances[$implName];
        try {
            $hash = $instance->hash($TEST_DATA, $algo);
            if ($hash !== '' && $hash !== null) {
                $hashResults[$implName] = $hash;
                $successCount++;
                printResult("  $implName", substr($hash, 0, 16) . '...');
            } else {
                printError("  $implName: Empty hash result");
            }
        } catch (Throwable $e) {
            printError("  $implName: " . $e->getMessage());
        }
    }
    
    // Check consistency among successful implementations
    if ($successCount >= 2) {
        $referenceHash = null;
        $consistent = true;
        
        foreach ($hashResults as $implName => $hash) {
            if ($referenceHash === null) {
                $referenceHash = $hash;
            } elseif ($hash !== $referenceHash) {
                $consistent = false;
                $inconsistencies[] = [
                    'algorithm' => $algo,
                    'implementations' => $implementations,
                    'results' => $hashResults
                ];
                break;
            }
        }
        
        if ($consistent) {
            printResult("  Consistency", "OK - All implementations agree");
        } else {
            printError("  Consistency: FAIL - Implementations produce different hashes");
            $allPassed = false;
        }
    }
    
    // Verify against expected value if available
    if (isset($EXPECTED_HASHES[$algo]) && $referenceHash !== null) {
        $expected = $EXPECTED_HASHES[$algo];
        if (hash_equals($referenceHash, $expected)) {
            printResult("  Verification", "OK - Matches expected value");
        } else {
            printError("  Verification: FAIL - Does not match expected value");
            printResult("    Expected", $expected, false);
            printResult("    Got", $referenceHash, false);
            $verificationFailures[] = [
                'algorithm' => $algo,
                'expected' => $expected,
                'got' => $referenceHash
            ];
            $allPassed = false;
        }
    } else {
        printWarning("  Verification: No expected value available");
    }
    
    echo "\n";
}

// ============================================================================
// Step 6: Summary and Final Report
// ============================================================================

printHeader('TEST SUMMARY');

echo "Available implementations: " . implode(', ', array_keys($instances)) . "\n";
echo "Test data: '$TEST_DATA'\n\n";

if (!empty($algorithmsToTest)) {
    echo "Tested algorithms: " . implode(', ', array_keys($algorithmsToTest)) . "\n\n";
}

// Inconsistency report
if (!empty($inconsistencies)) {
    printSection('INCONSISTENCIES DETECTED');
    foreach ($inconsistencies as $inconsistency) {
        echo "  Algorithm: " . $inconsistency['algorithm'] . "\n";
        echo "  Implementations: " . implode(', ', $inconsistency['implementations']) . "\n";
        echo "  Results:\n";
        foreach ($inconsistency['results'] as $impl => $hash) {
            echo "    $impl: " . substr($hash, 0, 32) . "...\n";
        }
        echo "\n";
    }
}

// Verification failure report
if (!empty($verificationFailures)) {
    printSection('VERIFICATION FAILURES');
    foreach ($verificationFailures as $failure) {
        echo "  Algorithm: " . $failure['algorithm'] . "\n";
        echo "  Expected: " . substr($failure['expected'], 0, 32) . "...\n";
        echo "  Got:      " . substr($failure['got'], 0, 32) . "...\n";
        echo "\n";
    }
}

// ============================================================================
// Step 7: Test RSA Asymmetric Functions
// ============================================================================

printHeader('RSA ASYMMETRIC CRYPTO TEST');

$rsaAllPassed = true;
$rsaInconsistencies = [];
$rsaFailures = [];

// Get RSA supported algorithms for each implementation
printSection('Step 7.1: Gathering supported RSA algorithms');

$supportedRSAAlgorithms = [];
foreach ($instances as $name => $instance) {
    try {
        $algorithms = $instance->getAlgorithmList(\Nebule\Library\Crypto::TYPE_ASYMMETRIC);
        $supportedRSAAlgorithms[$name] = $algorithms;
        printResult($name, !empty($algorithms) ? implode(', ', $algorithms) : 'None');
    } catch (Throwable $e) {
        printError("$name: Could not get asymmetric algorithm list - " . $e->getMessage());
        $supportedRSAAlgorithms[$name] = [];
    }
}

// Find common RSA algorithms across implementations
$commonRSAAlgorithms = [];
if (!empty($supportedRSAAlgorithms)) {
    $firstImpl = array_key_first($supportedRSAAlgorithms);
    if ($firstImpl !== null && !empty($supportedRSAAlgorithms[$firstImpl])) {
        $firstAlgos = $supportedRSAAlgorithms[$firstImpl];
        
        foreach ($firstAlgos as $algo) {
            $isCommon = true;
            foreach ($supportedRSAAlgorithms as $implName => $algos) {
                if (!in_array($algo, $algos)) {
                    $isCommon = false;
                    break;
                }
            }
            if ($isCommon) {
                $commonRSAAlgorithms[] = $algo;
            }
        }
    }
}

// Test with algorithms available in at least 2 implementations
$rsaAlgorithmsToTest = [];
$rsaMultiImplAlgorithms = [];
foreach ($supportedRSAAlgorithms as $implName => $algos) {
    foreach ($algos as $algo) {
        if (!isset($rsaMultiImplAlgorithms[$algo])) {
            $rsaMultiImplAlgorithms[$algo] = [];
        }
        $rsaMultiImplAlgorithms[$algo][] = $implName;
    }
}

foreach ($rsaMultiImplAlgorithms as $algo => $impls) {
    if (count($impls) >= 2) {
        $rsaAlgorithmsToTest[$algo] = $impls;
    }
}

if (!empty($rsaAlgorithmsToTest)) {
    printResult('Common RSA algorithms', implode(', ', array_keys($rsaAlgorithmsToTest)));
} else {
    printWarning('No RSA algorithms available in >=2 implementations');
}

// Use a specific RSA algorithm for testing
// We need an algorithm that works for at least one non-software implementation
// so that software can reuse the keys for signing/verification testing
$testRSAAlgo = '';

// Try to find an algorithm that works for at least one non-software implementation
// Prefer smaller algorithms that software can handle, but ensure at least one non-software implementation works
foreach (['rsa.512', 'rsa.256', 'rsa.2048', 'rsa.1024', 'rsa.4096'] as $preferredAlgo) {
    if (isset($rsaMultiImplAlgorithms[$preferredAlgo])) {
        // Check if any non-software implementation supports this algorithm
        $hasNonSoftwareSupport = false;
        foreach ($rsaMultiImplAlgorithms[$preferredAlgo] as $implName) {
            if ($implName !== 'software') {
                $hasNonSoftwareSupport = true;
                break;
            }
        }
        
        if ($hasNonSoftwareSupport) {
            $testRSAAlgo = $preferredAlgo;
            break;
        }
    }
}

// If no suitable algorithm found, fall back to any algorithm
if ($testRSAAlgo === '') {
    foreach (['rsa.512', 'rsa.256', 'rsa.1024', 'rsa.2048', 'rsa.4096'] as $preferredAlgo) {
        if (isset($rsaMultiImplAlgorithms[$preferredAlgo]) && count($rsaMultiImplAlgorithms[$preferredAlgo]) >= 1) {
            $testRSAAlgo = $preferredAlgo;
            break;
        }
    }
}

if ($testRSAAlgo !== '') {
    printResult('Testing RSA with algorithm', $testRSAAlgo);
    
    // ========================================================================
    // Step 7.2: Test RSA Key Generation
    // ========================================================================
    
    printSection('Step 7.2: Testing RSA key generation');
    
    $rsaKeyGenResults = [];
    $keyGenerationPassed = true;
    
    foreach ($instances as $name => $instance) {
        // Skip software implementation for key generation (too slow for large keys)
        if ($name === 'software') {
            printWarning("  $name: Key generation skipped (too slow for robust RSA)");
            continue;
        }
        
        try {
            $algorithms = $instance->getAlgorithmList(\Nebule\Library\Crypto::TYPE_ASYMMETRIC);
            if (!in_array($testRSAAlgo, $algorithms)) {
                printWarning("  $name: RSA algorithm $testRSAAlgo not supported");
                continue;
            }
            
            $start = microtime(true);
            $keys = $instance->newAsymmetricKeys('', $testRSAAlgo, 0);
            $end = microtime(true);
            $timeTaken = round($end - $start, 2);
            
            if (!empty($keys) && isset($keys['private']) && isset($keys['public'])) {
                $rsaKeyGenResults[$name] = [
                    'keys' => $keys,
                    'time' => $timeTaken,
                    'private_len' => strlen($keys['private']),
                    'public_len' => strlen($keys['public'])
                ];
                printResult($name, "Generated ($timeTaken s)");
            } else {
                printError("$name: Key generation failed");
                $keyGenerationPassed = false;
            }
        } catch (Throwable $e) {
            printError("$name: Key generation error - " . $e->getMessage());
            $keyGenerationPassed = false;
        }
    }
    
    // ========================================================================
    // Step 7.3: Test RSA Encryption and Decryption
    // ========================================================================
    
    printSection('Step 7.3: Testing RSA encryption/decryption');
    
    $encryptionResults = [];
    $encryptionPassed = true;
    
    foreach ($RSA_ENCRYPTION_TESTS as $testName => $testData) {
        printResult("Test", $testName . " - " . $testData);
        
        $testEncryptionResults = [];
        
        foreach ($rsaKeyGenResults as $name => $resultData) {
            try {
                $keys = $resultData['keys'];
                $instance = $instances[$name]; // Get the instance for this name
                
                // Encrypt
                $encrypted = $instance->encryptTo($testData, $keys['public']);
                if ($encrypted === '') {
                    throw new Exception('Encryption returned empty result');
                }
                
                // Decrypt
                $decrypted = $instance->decryptTo($encrypted, $keys['private'], '');
                if ($decrypted === '') {
                    throw new Exception('Decryption returned empty result');
                }
                
                $success = ($decrypted === $testData);
                $testEncryptionResults[$name] = [
                    'encrypted_len' => strlen($encrypted),
                    'decrypted' => $decrypted,
                    'success' => $success
                ];
                
                printResult($name, $success ? "PASS" : "FAIL (got: " . substr($decrypted, 0, 20) . ")");
                
                if (!$success) {
                    $encryptionPassed = false;
                }
            } catch (Throwable $e) {
                printError("$name: Encryption/Decryption error - " . $e->getMessage());
                $testEncryptionResults[$name] = ['error' => $e->getMessage(), 'success' => false];
                $encryptionPassed = false;
            }
        }
        
        $encryptionResults[$testName] = $testEncryptionResults;
        echo "\n";
    }
    
    // ========================================================================
    // Step 7.4: Test RSA Signing and Verification
    // ========================================================================
    
    printSection('Step 7.4: Testing RSA signing/verification');
    
    // Generate fallback keys for software testing if no other keys are available
    $softwareFallbackKeys = null;
    if (empty($rsaKeyGenResults) || count($rsaKeyGenResults) === 0) {
        // No keys generated by other implementations, generate fallback keys for software
        try {
            if (isset($instances['software'])) {
                $softwareFallbackKeys = $instances['software']->newAsymmetricKeys('', 'rsa.64', 0);
            }
        } catch (Throwable $e) {
            // Fallback failed, will skip software testing
        }
    }
    
    $signingResults = [];
    $signingPassed = true;
    
    foreach ($RSA_SIGNING_TESTS as $testName => $testData) {
        printResult("Test", $testName . " - " . $testData);
        
        $testSigningResults = [];
        
        // Test all implementations, including software using keys from other implementations
        $allInstances = array_keys($instances);
        foreach ($allInstances as $name) {
            try {
                $instance = $instances[$name];
                
                // For software implementation, use keys from the first available implementation
                if ($name === 'software' && !isset($rsaKeyGenResults['software'])) {
                    // Find first implementation that has keys
                    $keySource = null;
                    foreach ($rsaKeyGenResults as $srcName => $srcData) {
                        $keySource = $srcName;
                        break;
                    }
                    
                    if ($keySource !== null && isset($rsaKeyGenResults[$keySource]['keys'])) {
                        $keys = $rsaKeyGenResults[$keySource]['keys'];
                        $usingKeysFrom = $keySource;
                    } elseif ($softwareFallbackKeys !== null) {
                        // Use pre-generated fallback keys
                        $keys = $softwareFallbackKeys;
                        $usingKeysFrom = 'software_fallback';
                        printWarning("  $name: Using pre-generated fallback key pair for testing");
                    } else {
                        // No keys available
                        printWarning("  $name: Skipped - no keys available");
                        continue;
                    }
                } else {
                    // Use keys generated by this implementation
                    if (!isset($rsaKeyGenResults[$name])) {
                        printWarning("  $name: Skipped - no keys generated");
                        continue;
                    }
                    $keys = $rsaKeyGenResults[$name]['keys'];
                    $usingKeysFrom = $name;
                }
                
                // Sign with the current implementation
                $signature = $instance->sign($testData, $keys['private'], '');
                if ($signature === '') {
                    throw new Exception('Signing returned empty result');
                }
                
                // Verify with the current implementation
                $verified = $instance->verify($testData, $signature, $keys['public'], $testRSAAlgo);
                
                $testSigningResults[$name] = [
                    'signature_len' => strlen($signature),
                    'verified' => $verified,
                    'success' => $verified,
                    'keys_from' => $usingKeysFrom
                ];
                
                $resultText = $verified ? "PASS" : "FAIL";
                if (isset($usingKeysFrom) && $usingKeysFrom !== $name) {
                    $resultText .= " (using $usingKeysFrom keys)";
                }
                printResult($name, $resultText);
                
                if (!$verified) {
                    $signingPassed = false;
                }
            } catch (Throwable $e) {
                printError("$name: Signing/Verification error - " . $e->getMessage());
                $testSigningResults[$name] = ['error' => $e->getMessage(), 'success' => false];
                $signingPassed = false;
            }
        }
        
        $signingResults[$testName] = $testSigningResults;
        
        // Test with wrong data to ensure signature verification fails
        $wrongDataTestPassed = true;
        foreach ($allInstances as $name) {
            try {
                // Skip if no signature was generated for this implementation
                if (!isset($testSigningResults[$name]['signature'])) {
                    continue;
                }
                
                // For software, we need to find the original keys used
                if ($name === 'software') {
                    $keySource = $testSigningResults[$name]['keys_from'] ?? null;
                    if ($keySource === 'software_fallback' && $softwareFallbackKeys !== null) {
                        // Use the pre-generated fallback keys
                        $keys = $softwareFallbackKeys;
                    } elseif ($keySource !== null && isset($rsaKeyGenResults[$keySource]['keys'])) {
                        $keys = $rsaKeyGenResults[$keySource]['keys'];
                    } else {
                        continue;
                    }
                } else {
                    if (!isset($rsaKeyGenResults[$name]['keys'])) {
                        continue;
                    }
                    $keys = $rsaKeyGenResults[$name]['keys'];
                }
                
                $instance = $instances[$name];
                $wrongData = $testData . 'wrong';
                
                // This should fail
                $verifiedWrong = $instance->verify($wrongData, $testSigningResults[$name]['signature'] ?? '', $keys['public'], $testRSAAlgo);
                
                if ($verifiedWrong === false) {
                    // Good, it correctly failed
                } else {
                    printError("$name: Wrong data verification should have failed but passed");
                    $wrongDataTestPassed = false;
                }
            } catch (Throwable $e) {
                // This is acceptable for wrong data verification
            }
        }
        
        echo "\n";
    }
    
    // Update overall RSA test result
    // Software is skipped in key generation, so we only care about other implementations for key generation
    // But we include software in signing/verification tests
    $rsaAllPassed = $encryptionPassed && $signingPassed && $wrongDataTestPassed;
    
    // ============================================================================
    // Step 7.5: RSA Test Summary
    // ============================================================================
    
    printSection('RSA Test Summary');
    
    echo "  Key Generation:     " . ($keyGenerationPassed ? "[PASS]" : "[FAIL]") . "\n";
    echo "  Encryption/Decrypt: " . ($encryptionPassed ? "[PASS]" : "[FAIL]") . "\n";
    echo "  Signing/Verify:      " . ($signingPassed ? "[PASS]" : "[FAIL]") . "\n";
    echo "  Overall RSA Tests:   " . ($rsaAllPassed ? "[PASS]" : "[FAIL]") . "\n";
    
    if (!$rsaAllPassed) {
        echo "\n  RSA test failures detected:\n";
        if (!$keyGenerationPassed) {
            echo "    - Key generation issues\n";
        }
        if (!$encryptionPassed) {
            echo "    - Encryption/decryption issues\n";
        }
        if (!$signingPassed) {
            echo "    - Signing/verification issues\n";
        }
    }
} else {
    printWarning('RSA tests skipped - no suitable algorithm found across implementations');
    $rsaAllPassed = true; // Don't fail overall if RSA is not available
}

// ============================================================================
// Step 8: Test ED25519 Asymmetric Functions
// ============================================================================

printHeader('ED25519 ASYMMETRIC CRYPTO TEST');

$ed25519AllPassed = true;
$ed25519SigningPassed = true;

// Test ED25519 with software implementation
if (isset($instances['software'])) {
    printSection('Step 8.1: Testing ED25519 signing/verification with pre-generated keys');
    
    $ed25519SigningResults = [];
    
    try {
        // Generate test keys from seed (fast, deterministic)
        $ed25519 = new \Nebule\Library\ED25519Software();
        $keys = $ed25519->generateKeyPairFromSeed($ED25519_TESTSeed);
        
        if (empty($keys) || !isset($keys['private']) || !isset($keys['public'])) {
            printError('ED25519 key generation from seed failed');
            $ed25519SigningPassed = false;
        } else {
            printResult('Key generation from seed', 'Success - private: ' . strlen($keys['private']) . ' chars, public: ' . strlen($keys['public']) . ' chars');
            
            foreach ($ED25519_SIGNING_TESTS as $testName => $testData) {
                printResult('Test', $testName . ' - ' . $testData);
                
                try {
                    // Convert keys to the format expected by CryptoSoftware methods
                    // ED25519 keys from ED25519Software are already in hex format
                    $instance = $instances['software'];
                    
                    // Test direct ED25519Software usage
                    $signature = $ed25519->sign($testData, $keys['private'], '');
                    if ($signature === '') {
                        throw new \Exception('ED25519 signing returned empty result');
                    }
                    
                    $verified = $ed25519->verify($testData, $signature, $keys['public']);
                    
                    $ed25519SigningResults[$testName] = [
                        'signature_len' => strlen($signature),
                        'verified' => $verified,
                        'success' => $verified
                    ];
                    
                    printResult('Software (direct)', $verified ? 'PASS' : 'FAIL');
                    
                    if (!$verified) {
                        $ed25519SigningPassed = false;
                    }
                    
                    // Test through CryptoSoftware interface
                    $cryptoSignature = $instance->sign($testData, $keys['private'], '');
                    if ($cryptoSignature === '') {
                        throw new \Exception('CryptoSoftware ED25519 signing returned empty result');
                    }
                    
                    $cryptoVerified = $instance->verify($testData, $cryptoSignature, $keys['public'], 'ed25519');
                    
                    printResult('Software (via Crypto)', $cryptoVerified ? 'PASS' : 'FAIL');
                    
                    if (!$cryptoVerified) {
                        $ed25519SigningPassed = false;
                    }
                    
                    // Test with wrong data
                    $wrongData = $testData . 'wrong';
                    $wrongVerified = $instance->verify($wrongData, $cryptoSignature, $keys['public'], 'ed25519');
                    
                    if ($wrongVerified === true) {
                        printError('Wrong data verification should have failed but passed');
                        $ed25519SigningPassed = false;
                    } else {
                        printResult('Wrong data verification', 'Correctly failed');
                    }
                    
                } catch (\Exception $e) {
                    printError('ED25519 error: ' . $e->getMessage());
                    $ed25519SigningResults[$testName] = ['error' => $e->getMessage(), 'success' => false];
                    $ed25519SigningPassed = false;
                }
                
                echo "\n";
            }
        }
    } catch (\Exception $e) {
        printError('ED25519 setup failed: ' . $e->getMessage());
        $ed25519SigningPassed = false;
    }
    
    $ed25519AllPassed = $ed25519SigningPassed;
    
    // ============================================================================
    // Step 8.2: ED25519 Test Summary
    // ============================================================================
    
    printSection('ED25519 Test Summary');
    
    echo "  Signing/Verify:      " . ($ed25519SigningPassed ? "[PASS]" : "[FAIL]") . "\n";
    echo "  Overall ED25519 Tests:" . ($ed25519AllPassed ? "[PASS]" : "[FAIL]") . "\n";
    
    if (!$ed25519AllPassed) {
        echo "\n  ED25519 test failures detected:\n";
        if (!$ed25519SigningPassed) {
            echo "    - Signing/verification issues\n";
        }
    }
} else {
    printWarning('ED25519 tests skipped - software implementation not available');
    $ed25519AllPassed = true; // Don't fail overall if ED25519 is not available
}

// Final result
printSection('FINAL RESULT');

// Overall test result
$overallPassed = $allPassed && $rsaAllPassed && $ed25519AllPassed;

if ($overallPassed) {
    echo "  [SUCCESS] All hash functions are consistent across implementations!\n";
    echo "  [SUCCESS] All verified hashes match expected values!\n";
    echo "  [SUCCESS] RSA asymmetric cryptography tests passed!\n";
    echo "  [SUCCESS] ED25519 asymmetric cryptography tests passed!\n";
    exit(0);
} else {
    echo "  [FAILURE] Issues detected during cryptographic testing\n";
    
    $hasIssues = false;
    
    if (!$allPassed) {
        if (!empty($inconsistencies)) {
            echo "  - " . count($inconsistencies) . " hash consistency issue(s) found\n";
            $hasIssues = true;
        }
        if (!empty($verificationFailures)) {
            echo "  - " . count($verificationFailures) . " hash verification failure(s) found\n";
            $hasIssues = true;
        }
    }
    
    if (!$rsaAllPassed) {
        echo "  - RSA cryptography tests failed\n";
        $hasIssues = true;
    }
    
    if (!$ed25519AllPassed) {
        echo "  - ED25519 cryptography tests failed\n";
        $hasIssues = true;
    }
    
    if ($hasIssues) {
        exit(1);
    } else {
        exit(0);
    }
}
